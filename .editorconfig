root = true

# LF everywhere: Claude Code reads these files on every platform, straight from
# the git checkout a marketplace install makes.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[LICENSE]
trim_trailing_whitespace = false
insert_final_newline = false
